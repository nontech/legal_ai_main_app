# Server-only analysis API origin. Leave unset for http://localhost:8000.
# Loopback skips Cloud Run IAM. Any other host must be https.
# The private Cloud Run URL in europe-west3 is not assigned yet. Set it here
# when it exists. Do not commit real secrets, and do not put this URL in a
# NEXT_PUBLIC_ variable.

BACKEND_URL=

# Optional fallback read only on the server when BACKEND_URL is unset.
# Do not set the private Cloud Run URL here. Next.js exposes NEXT_PUBLIC_
# values to the browser when client code references them.
# NEXT_PUBLIC_API_URL=

# Workload Identity Federation for private Cloud Run. Copy these from the
# Google Cloud console for project project-8531ab21-2146-4309-9b2.
# Do not invent pool, provider, or service account ids in this file.
# Vercel injects VERCEL_OIDC_TOKEN when OIDC is enabled. Do not paste a token.
#
# GCP_PROJECT_ID=project-8531ab21-2146-4309-9b2
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Or paste the full provider resource instead of the three fields above:
# GCP_WORKLOAD_IDENTITY_PROVIDER=
# Set only when the provider uses Google's default audience. Copy the https
# URL from the provider details page. It is passed to Vercel OIDC.
# GCP_AUDIENCE=

# Main Supabase (user cases and auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CMS Supabase (admin reference data)
NEXT_PUBLIC_SUPABASE_CMS_URL=
NEXT_PUBLIC_SUPABASE_CMS_PUBLISHABLE_KEY=

# Optional daily limits
ANONYMOUS_CASE_LIMIT_PER_IP_PER_DAY=3
USER_CASES_PER_DAY=5
USER_ANALYSES_PER_DAY=10
USER_GAME_PLANS_PER_DAY=3

# Product analytics (PostHog EU cloud, org thelawthing).
# The browser sends to /ingest, which Next.js proxies to the EU ingestion host.
# NEXT_PUBLIC_POSTHOG_HOST is the server SDK host. Leave it as the EU ingestion host.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
